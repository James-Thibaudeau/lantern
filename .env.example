# Copy to .env (git-ignored) and fill in.

# Your private runner repo, owner/name.
LANTERN_RUNNER_REPO=you/lantern-runner

# Fine-grained personal access token for the runner repo ONLY, with
# Actions: read and write (sync, Run now), Contents: read and write (watchlist).
# Left empty, sync falls back to your gh CLI login.
LANTERN_GITHUB_TOKEN=

# Optional: where the SQLite database lives (default data/lantern.db).
# LANTERN_DB=data/lantern.db
