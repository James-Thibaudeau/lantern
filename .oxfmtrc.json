{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": true,
  "sortTailwindcss": { "stylesheet": "./src/styles.css" },
  "ignorePatterns": ["src/routeTree.gen.ts", "src/pipeline/__tests__/fixtures/**", "pnpm-lock.yaml"]
}
